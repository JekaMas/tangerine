{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/llm-quality-case.schema.json",
  "title": "llm-quality-case",
  "type": "object",
  "description": "Frozen quality dataset row; input/expectation assets use their owning current stage/evaluator contracts.",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "description": "Dataset case identity."
    },
    "stage": {
      "type": "string",
      "enum": [
        "case_generation",
        "linguistic_audit",
        "blind_claim_extraction",
        "claim_mapping",
        "mapping_audit",
        "feedback",
        "case_review",
        "adjudication"
      ],
      "description": "Stage under test."
    },
    "phase": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "canonical_text",
            "mutation"
          ],
          "description": "Generation phase; null for other stages."
        },
        {
          "type": "null"
        }
      ],
      "description": "Generation phase; null for other stages."
    },
    "polarity": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ],
      "description": "Constructed/reference scenario polarity."
    },
    "origin": {
      "type": "string",
      "enum": [
        "constructed",
        "source_derived",
        "observed_run"
      ],
      "description": "Actual data origin, not empirical gold by default."
    },
    "expectation_basis": {
      "type": "string",
      "enum": [
        "authored_assertion",
        "native_annotation",
        "independent_llm",
        "self_consistency"
      ],
      "description": "Reference basis; independent_llm requires its actual independent receipt."
    },
    "group_id": {
      "type": "string",
      "description": "Shared source/speaker/edit-family grouping; do not leak into held-out comparisons."
    },
    "split": {
      "type": "string",
      "enum": [
        "development",
        "held_out"
      ],
      "description": "Declared split with explicit group separation."
    },
    "taxonomy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Preserved project leaf ID."
      },
      "description": "Selected leaves, including controls."
    },
    "input_asset_id": {
      "type": "string",
      "description": "Exact stage inputs and relevant frozen case/audio/key/answer identities."
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Actual input asset/projection hash."
    },
    "expectations_asset_id": {
      "type": "string",
      "description": "Typed expected evaluator-output/native credit assertions or semantic rubric with supported/unsupported/unknown propositions; see docs/llm-lab.md."
    },
    "expectations_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Frozen expected assertions/rubric hash."
    },
    "reference_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Actual reference/judge receipt identity."
      },
      "description": "Empty for authored assertions, actual IDs otherwise."
    },
    "context_asset_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional exact upstream context-components asset for saved-stage replay, separate from the unchanged typed input DTO."
    },
    "context_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Actual context asset byte digest when context_asset_id is supplied.",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "stage",
    "phase",
    "polarity",
    "origin",
    "expectation_basis",
    "group_id",
    "split",
    "taxonomy_ids",
    "input_asset_id",
    "input_sha256",
    "expectations_asset_id",
    "expectations_sha256",
    "reference_receipt_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "expectations": {
      "type": "object",
      "description": "Frozen authored/native/independent semantic expectations. These are not outputs generated by the candidate under test.",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "expected_mapping": {
          "anyOf": [
            {
              "$ref": "evaluator-output.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_metric_values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string"
              },
              "numerator": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "denominator": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "metric_id",
              "numerator",
              "denominator",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "expected_canonical_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_propositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "proposition": {
                "type": "string"
              },
              "expected": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "canonical_text",
                  "mutation",
                  "answer_mapping",
                  "feedback",
                  "acoustic"
                ]
              }
            },
            "required": [
              "id",
              "proposition",
              "expected",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "expected_mapping",
        "expected_metric_values",
        "expected_canonical_sha256",
        "semantic_propositions"
      ],
      "additionalProperties": false
    }
  }
}
