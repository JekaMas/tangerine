{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/teacher-rationale.schema.json",
  "title": "Teacher rationale projection",
  "type": "object",
  "description": "Post-submit approved linguistic text only. No reviewer, evidence, consent or private provenance IDs.",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "The unit.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "language": {
      "type": "string",
      "description": "The response language.",
      "enum": [
        "en",
        "ru"
      ]
    },
    "text": {
      "type": "string",
      "description": "The approved explanation text.",
      "maxLength": 12000,
      "minLength": 1
    },
    "required_proposition_ids": {
      "type": "array",
      "description": "The exact required rationale propositions.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "forbidden_proposition_ids": {
      "type": "array",
      "description": "The exact forbidden rationale propositions.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "text_sha256": {
      "type": "string",
      "description": "The UTF-8 explanation digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "unit_id",
    "language",
    "text",
    "required_proposition_ids",
    "forbidden_proposition_ids",
    "text_sha256"
  ],
  "additionalProperties": false
}
