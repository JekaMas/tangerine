{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/claim-extraction.schema.json",
  "title": "claim-extraction",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "The explicit changed local contract version."
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_span": {
            "type": "object",
            "properties": {
              "start_cp": {
                "type": "integer",
                "minimum": 0,
                "description": "This offset is the included start of a Unicode codepoint span."
              },
              "end_cp": {
                "type": "integer",
                "minimum": 0,
                "description": "This offset is the excluded end of a Unicode codepoint span."
              },
              "exact_text": {
                "type": "string",
                "description": "This text must equal the original substring at the specified codepoint offsets."
              }
            },
            "required": [
              "start_cp",
              "end_cp",
              "exact_text"
            ],
            "additionalProperties": false,
            "description": "This span quotes the full claim from the original answer."
          },
          "stance": {
            "type": "string",
            "enum": [
              "assert_error",
              "assert_acceptable",
              "question",
              "meta",
              "retracted"
            ],
            "description": "This field distinguishes an error assertion, permitted-form assertion, question, comment, or retraction."
          },
          "target_span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the included start of a Unicode codepoint span."
                  },
                  "end_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the excluded end of a Unicode codepoint span."
                  },
                  "exact_text": {
                    "type": "string",
                    "description": "This text must equal the original substring at the specified codepoint offsets."
                  }
                },
                "required": [
                  "start_cp",
                  "end_cp",
                  "exact_text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "This span quotes the target that the teacher identified in the original answer."
          },
          "category_span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the included start of a Unicode codepoint span."
                  },
                  "end_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the excluded end of a Unicode codepoint span."
                  },
                  "exact_text": {
                    "type": "string",
                    "description": "This text must equal the original substring at the specified codepoint offsets."
                  }
                },
                "required": [
                  "start_cp",
                  "end_cp",
                  "exact_text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "This span quotes the category from the original teacher answer."
          },
          "correction_span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the included start of a Unicode codepoint span."
                  },
                  "end_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the excluded end of a Unicode codepoint span."
                  },
                  "exact_text": {
                    "type": "string",
                    "description": "This text must equal the original substring at the specified codepoint offsets."
                  }
                },
                "required": [
                  "start_cp",
                  "end_cp",
                  "exact_text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "This span quotes the proposed correction from the original answer."
          },
          "rationale_span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the included start of a Unicode codepoint span."
                  },
                  "end_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the excluded end of a Unicode codepoint span."
                  },
                  "exact_text": {
                    "type": "string",
                    "description": "This text must equal the original substring at the specified codepoint offsets."
                  }
                },
                "required": [
                  "start_cp",
                  "end_cp",
                  "exact_text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "This span quotes the explanation from the original teacher answer."
          },
          "explicit_retraction_of_span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the included start of a Unicode codepoint span."
                  },
                  "end_cp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This offset is the excluded end of a Unicode codepoint span."
                  },
                  "exact_text": {
                    "type": "string",
                    "description": "This text must equal the original substring at the specified codepoint offsets."
                  }
                },
                "required": [
                  "start_cp",
                  "end_cp",
                  "exact_text"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "This span identifies the original assertion that the teacher explicitly retracts."
          },
          "local_ref": {
            "type": "string",
            "pattern": "^c[0-9]+$",
            "maxLength": 20,
            "description": "An extraction-local reference. The server checks uniqueness and assigns stable persistent IDs."
          }
        },
        "required": [
          "claim_span",
          "stance",
          "target_span",
          "category_span",
          "correction_span",
          "rationale_span",
          "explicit_retraction_of_span",
          "local_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "description": "These records preserve the extracted claims and their original answer spans."
    },
    "unparsed_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_cp": {
            "type": "integer",
            "minimum": 0,
            "description": "This offset is the included start of a Unicode codepoint span."
          },
          "end_cp": {
            "type": "integer",
            "minimum": 0,
            "description": "This offset is the excluded end of a Unicode codepoint span."
          },
          "exact_text": {
            "type": "string",
            "description": "This text must equal the original substring at the specified codepoint offsets."
          }
        },
        "required": [
          "start_cp",
          "end_cp",
          "exact_text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "description": "These spans preserve substantive answer text that the extractor cannot resolve."
    },
    "coverage": {
      "type": "array",
      "description": "Optional model hint; server derives complete canonical coverage from validated original spans.",
      "items": {
        "type": "object",
        "description": "A source interval. The union must cover the whole answer.",
        "properties": {
          "span": {
            "type": "object",
            "description": "A half-open text interval. End must be greater than start except an insertion location.",
            "properties": {
              "start": {
                "type": "integer",
                "description": "Inclusive Unicode codepoint offset.",
                "minimum": 0,
                "maximum": 2000000
              },
              "end": {
                "type": "integer",
                "description": "Exclusive Unicode codepoint offset.",
                "minimum": 0,
                "maximum": 2000000
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "description": "The explicit span disposition.",
            "enum": [
              "claim",
              "attachment",
              "unparsed",
              "non_assertive",
              "whitespace"
            ]
          },
          "claim_refs": {
            "type": "array",
            "description": "Existing extraction-local claim references.",
            "items": {
              "type": "string",
              "description": "An existing identifier.",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 100000,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "description": "A reason for a non-claim disposition.",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "span",
          "kind",
          "claim_refs",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "relations": {
      "type": "array",
      "description": "Explicit source relations.",
      "items": {
        "type": "object",
        "description": "An acyclic source-supported relation.",
        "properties": {
          "from_claim_ref": {
            "type": "string",
            "description": "The dependent later claim.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "to_claim_ref": {
            "type": "string",
            "description": "The earlier claim.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "description": "The explicitly supported relation.",
            "enum": [
              "correction_attachment",
              "explanation_attachment",
              "retracts",
              "exact_duplicate",
              "compatible_fragment"
            ]
          },
          "evidence_span": {
            "type": "object",
            "description": "A half-open text interval. End must be greater than start except an insertion location.",
            "properties": {
              "start": {
                "type": "integer",
                "description": "Inclusive Unicode codepoint offset.",
                "minimum": 0,
                "maximum": 2000000
              },
              "end": {
                "type": "integer",
                "description": "Exclusive Unicode codepoint offset.",
                "minimum": 0,
                "maximum": 2000000
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "from_claim_ref",
          "to_claim_ref",
          "kind",
          "evidence_span"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4000
    }
  },
  "required": [
    "schema_version",
    "clauses",
    "unparsed_spans",
    "relations"
  ],
  "additionalProperties": false
}
