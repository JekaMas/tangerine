{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/interpretation-checkpoint.schema.json",
  "title": "interpretation-checkpoint",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "answer_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "review_required",
        "failed"
      ]
    },
    "resources_asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "extraction_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "issues_asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stages_asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "attempt_id",
    "case_version_id",
    "answer_sha256",
    "configuration_sha256",
    "prompt_bundle_sha256",
    "status",
    "resources_asset_id",
    "extraction_asset_id",
    "mapping_asset_id",
    "audit_asset_id",
    "issues_asset_id",
    "stages_asset_id",
    "failure_code"
  ],
  "additionalProperties": false
}
