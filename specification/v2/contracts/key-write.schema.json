{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/key-write.schema.json",
  "title": "key-write",
  "type": "object",
  "description": "Create or revise a reviewed key candidate before publication. No automatic human approval.",
  "properties": {
    "ground_truth": {
      "$ref": "ground-truth.schema.json"
    },
    "rationale_records": {
      "type": "array",
      "description": "Actually supplied rationale records.",
      "items": {
        "$ref": "rationale.schema.json"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "candidate_sha256": {
      "type": "string",
      "description": "The frozen planned candidate.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "ground_truth",
    "rationale_records",
    "candidate_sha256"
  ],
  "additionalProperties": false
}
