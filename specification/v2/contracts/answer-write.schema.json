{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/answer-write.schema.json",
  "title": "answer-write",
  "type": "object",
  "description": "A draft answer or final submission. The API computes the hash.",
  "properties": {
    "answer_text": {
      "type": "string",
      "description": "The exact UTF-8 answer decoded to Unicode.",
      "maxLength": 20000,
      "minLength": 0
    },
    "requested_language": {
      "type": "string",
      "description": "The response language.",
      "enum": [
        "en",
        "ru"
      ]
    }
  },
  "required": [
    "answer_text",
    "requested_language"
  ],
  "additionalProperties": false
}
