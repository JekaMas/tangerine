{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/acoustic-edit.schema.json",
  "title": "acoustic-edit",
  "type": "object",
  "description": "Exact on-demand LLM acoustic edit; unobserved until actual synthesis/transform.",
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Existing version-scoped identifier."
    },
    "utterance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Existing version-scoped identifier."
    },
    "scope": {
      "type": "object",
      "description": "Half-open codepoint interval in the saved surface utterance; end exceeds start.",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Nonnegative exact integer."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Nonnegative exact integer."
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "controller": {
      "type": "string",
      "enum": [
        "phone_pair",
        "vowel_duration",
        "pitch_duration",
        "pause_insert",
        "vot_edit"
      ],
      "description": "Exactly one declared value."
    },
    "parameters": {
      "type": "object",
      "description": "Explicit parameters selected by the mutation LLM and consumed by the native compiler. Null unused fields; no executable text.",
      "properties": {
        "duration_ratio": {
          "anyOf": [
            {
              "type": "number",
              "description": "Positive target/source duration ratio; never a universal language norm."
            },
            {
              "type": "null"
            }
          ],
          "description": "Positive target/source duration ratio; never a universal language norm."
        },
        "gain_db": {
          "anyOf": [
            {
              "type": "number",
              "description": "Declared gain within the selected interval."
            },
            {
              "type": "null"
            }
          ],
          "description": "Declared gain within the selected interval."
        },
        "pitch_points": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Typed private contract.",
            "properties": {
              "fraction": {
                "type": "number",
                "description": "Position in [0,1] of this interval."
              },
              "semitones": {
                "type": "number",
                "description": "Offset above 100Hz; explicit target, not measurement."
              }
            },
            "required": [
              "fraction",
              "semitones"
            ],
            "additionalProperties": false
          },
          "description": "Ordered complete values."
        },
        "pause_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Nonnegative exact integer."
            },
            {
              "type": "null"
            }
          ],
          "description": "Nonnegative exact integer."
        },
        "vot_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Nonnegative exact integer."
            },
            {
              "type": "null"
            }
          ],
          "description": "Nonnegative exact integer."
        },
        "reference_ipa": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Exact saved value."
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact saved value."
        },
        "mutated_ipa": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Exact saved value."
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact saved value."
        },
        "phone_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Nonnegative exact integer."
            },
            {
              "type": "null"
            }
          ],
          "description": "Nonnegative exact integer."
        },
        "phone_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "Nonnegative exact integer."
            },
            {
              "type": "null"
            }
          ],
          "description": "Nonnegative exact integer."
        },
        "expected_feature": {
          "type": "string",
          "minLength": 1,
          "description": "Exact saved value."
        },
        "accepted_reference": {
          "type": "string",
          "minLength": 1,
          "description": "Self-contained task-specific acceptable comparison, never a population norm."
        }
      },
      "required": [
        "duration_ratio",
        "gain_db",
        "pitch_points",
        "pause_ms",
        "vot_ms",
        "reference_ipa",
        "mutated_ipa",
        "phone_start",
        "phone_end",
        "expected_feature",
        "accepted_reference"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "unit_id",
    "utterance_id",
    "scope",
    "controller",
    "parameters"
  ],
  "additionalProperties": false
}
