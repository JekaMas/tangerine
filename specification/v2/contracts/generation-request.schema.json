{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/generation-request.schema.json",
  "title": "generation-request",
  "type": "object",
  "description": "One bounded synchronous generation request.",
  "properties": {
    "blueprint_id": {
      "type": "string",
      "description": "The frozen blueprint.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "effective_configuration_sha256": {
      "type": "string",
      "description": "The selected configuration.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_record_ids": {
      "type": "array",
      "description": "Explicit permitted source records.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "generation_attempt": {
      "type": "integer",
      "description": "Positive monotonic explicit preparation attempt counter; no lifetime limit. Each action retains its own deadline and retry rules.",
      "minimum": 1
    }
  },
  "required": [
    "blueprint_id",
    "effective_configuration_sha256",
    "source_record_ids",
    "generation_attempt"
  ],
  "additionalProperties": false
}
