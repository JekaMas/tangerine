{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/provider-access-policy.schema.json",
  "title": "provider-access-policy",
  "description": "Current user policy: local inference, provider free tiers or included recurring allowance only; no purchased usage credits or overage.",
  "type": "object",
  "properties": {
    "mode": {
      "const": "included_only"
    },
    "allow_purchased_credits": {
      "const": false
    },
    "allow_overage": {
      "const": false
    },
    "allow_silent_billing_fallback": {
      "const": false
    }
  },
  "required": [
    "mode",
    "allow_purchased_credits",
    "allow_overage",
    "allow_silent_billing_fallback"
  ],
  "additionalProperties": false
}
