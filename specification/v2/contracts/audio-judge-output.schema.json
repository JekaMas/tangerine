{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/audio-judge-output.schema.json",
  "title": "audio-judge-output",
  "type": "object",
  "description": "Tolerantly normalized auditory model result with additional model annotations retained. Known judgments/coordinates remain typed; annotations never become native scores. Raw response and actual receipt are retained.",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "Current written contract version."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Model inference, not native calibrated phone/prosody score.",
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "description": "Existing version-scoped identifier."
          },
          "feature": {
            "type": "string",
            "minLength": 1,
            "description": "Exact saved value."
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "uncertain",
              "not_applicable"
            ],
            "description": "Exactly one declared value."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Exact saved value."
          },
          "clip_interval": {
            "anyOf": [
              {
                "type": "object",
                "description": "Half-open sample interval on the saved 24kHz piece; end exceeds start.",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Nonnegative exact integer."
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Nonnegative exact integer."
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Half-open sample interval on the saved 24kHz piece; end exceeds start."
          },
          "proposed_ipa": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "Exact saved value."
              },
              {
                "type": "null"
              }
            ],
            "description": "Exact saved value."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Exact saved value."
          }
        },
        "required": [
          "unit_id",
          "feature",
          "status",
          "description",
          "clip_interval",
          "proposed_ipa",
          "reason"
        ],
        "additionalProperties": true
      },
      "description": "Ordered complete values."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Exact saved value."
    }
  },
  "required": [
    "schema_version",
    "findings",
    "summary"
  ],
  "additionalProperties": true
}
