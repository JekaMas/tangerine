{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/adjudication.schema.json",
  "title": "adjudication",
  "type": "object",
  "description": "A human resolution. It does not fabricate the two required final approvals.",
  "properties": {
    "id": {
      "type": "string",
      "description": "The actual adjudication.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "case_version_id": {
      "type": "string",
      "description": "The exact version.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "audio_sha256": {
      "type": "string",
      "description": "The exact heard file.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "adjudicator_person_id": {
      "type": "string",
      "description": "A genuine third qualified person.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "qualification_ids": {
      "type": "array",
      "description": "Applicable actual competence.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "prior_review_decision_ids": {
      "type": "array",
      "description": "The conflicting preserved reviews.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "unit_ids": {
      "type": "array",
      "description": "The exact disputed units.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "description": "Actual supporting evidence.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "resolution": {
      "type": "string",
      "description": "The supported outcome.",
      "enum": [
        "approve_interpretation",
        "reject_key",
        "insufficient_evidence"
      ]
    },
    "reason": {
      "type": "string",
      "description": "The actual detailed judgment.",
      "maxLength": 10000,
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "description": "The actual decision time.",
      "maxLength": 35,
      "minLength": 20,
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "case_version_id",
    "audio_sha256",
    "adjudicator_person_id",
    "qualification_ids",
    "prior_review_decision_ids",
    "unit_ids",
    "evidence_ids",
    "resolution",
    "reason",
    "created_at"
  ],
  "additionalProperties": false
}
