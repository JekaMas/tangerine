{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/deletion-request.schema.json",
  "title": "deletion-request",
  "type": "object",
  "description": "Exact private deletion preview/result with identifier-only membership. Confirmation guards destructive changes, not accepted content. Copied Lab and byte cleanup stay explicit.",
  "properties": {
    "id": {
      "type": "string"
    },
    "selection": {
      "type": "object",
      "properties": {
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphan_cleanup": {
          "type": "boolean"
        }
      },
      "required": [
        "subject_ids",
        "orphan_cleanup"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storage_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "releases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "releases",
        "imports",
        "files",
        "asset_ids",
        "reports",
        "experiments"
      ],
      "additionalProperties": false
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "preview",
        "blocked_active_reference",
        "native_erased",
        "erased",
        "native_erased_media_cleanup_pending"
      ]
    },
    "lab_cleanup": {
      "type": "string",
      "enum": [
        "not_requested",
        "pending_explicit_local_lab_cleanup",
        "erased"
      ]
    }
  },
  "required": [
    "id",
    "selection",
    "documents",
    "assets",
    "storage_keys",
    "operations",
    "heads",
    "source",
    "blocked",
    "confirmation_sha256",
    "state",
    "lab_cleanup"
  ],
  "additionalProperties": false
}
