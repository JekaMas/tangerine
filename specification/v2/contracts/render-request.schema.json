{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/render-request.schema.json",
  "title": "render-request",
  "type": "object",
  "description": "One actual synthesis operation.",
  "properties": {
    "plan": {
      "$ref": "render-plan.schema.json"
    },
    "render_attempt": {
      "type": "integer",
      "description": "The explicit synthesis attempt number.",
      "minimum": 1,
      "maximum": 3
    }
  },
  "required": [
    "plan",
    "render_attempt"
  ],
  "additionalProperties": false
}
