# Supply local secrets. Do not commit the completed .env file.
POSTGRES_PASSWORD=
# URL-encode the same password in the PostgreSQL connection URL.
DATABASE_URL=postgres://tangerine:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/tangerine?sslmode=disable
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
INITIAL_EMAIL=owner@localhost
# At least 16 bytes. Existing accounts are never rotated by initialization.
INITIAL_PASSWORD=
# Provider credentials are only needed for dependent live operations.
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
