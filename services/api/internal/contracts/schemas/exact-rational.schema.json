{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/exact-rational.schema.json",
  "title": "exact-rational",
  "type": "object",
  "description": "An exact rational. GCD of the magnitudes is one. Zero is 0/1.",
  "properties": {
    "numerator": {
      "type": "string",
      "description": "The signed reduced numerator.",
      "maxLength": 4097,
      "minLength": 1,
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "denominator": {
      "type": "string",
      "description": "The positive reduced denominator.",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[1-9][0-9]*$"
    }
  },
  "required": [
    "numerator",
    "denominator"
  ],
  "additionalProperties": false
}
