{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/render-progress.schema.json",
  "title": "render-progress",
  "type": "object",
  "description": "Durable immutable private render journal; PostgreSQL head and existing private MinIO assets.",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "Current written contract version."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Existing version-scoped identifier."
    },
    "preparation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Existing version-scoped identifier."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Nonnegative exact integer."
    },
    "render_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
    },
    "production_plan_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "description": "Existing version-scoped identifier."
        },
        {
          "type": "null"
        }
      ],
      "description": "Existing version-scoped identifier."
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One complete reusable render piece; incomplete stream is not an audio asset.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "description": "Existing version-scoped identifier."
          },
          "utterance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "description": "Existing version-scoped identifier."
          },
          "operation_indexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "description": "Nonnegative exact integer."
            },
            "description": "Ordered complete values."
          },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
          },
          "source_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "description": "Existing version-scoped identifier."
              },
              {
                "type": "null"
              }
            ],
            "description": "Existing version-scoped identifier."
          },
          "asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "description": "Existing version-scoped identifier."
              },
              {
                "type": "null"
              }
            ],
            "description": "Existing version-scoped identifier."
          },
          "audio_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
              },
              {
                "type": "null"
              }
            ],
            "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
          },
          "sample_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "description": "Nonnegative exact integer."
              },
              {
                "type": "null"
              }
            ],
            "description": "Nonnegative exact integer."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "complete",
              "failed",
              "interrupted"
            ],
            "description": "Exactly one declared value."
          },
          "receipt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "description": "Existing version-scoped identifier."
            },
            "description": "Ordered complete values."
          },
          "last_error_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "description": "Existing version-scoped identifier."
              },
              {
                "type": "null"
              }
            ],
            "description": "Existing version-scoped identifier."
          },
          "acoustic_state": {
            "type": "object",
            "description": "Private incremental acoustic state, actual source/reference/plan/result asset lineage; absent on plain pieces.",
            "properties": {
              "native_asset_id": {
                "type": "string"
              },
              "current_asset_id": {
                "type": "string"
              },
              "active_production_plan_asset_id": {
                "type": "string"
              },
              "next_step": {
                "type": "integer",
                "minimum": 0
              },
              "completed_steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "production_plan_asset_id": {
                      "type": "string"
                    },
                    "source_asset_id": {
                      "type": "string"
                    },
                    "result_asset_id": {
                      "type": "string"
                    },
                    "diagnostic_asset_id": {
                      "type": "string"
                    },
                    "unit_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "production_plan_asset_id",
                    "source_asset_id",
                    "result_asset_id",
                    "diagnostic_asset_id",
                    "unit_id"
                  ],
                  "additionalProperties": false
                }
              },
              "paired_assets": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Private whole-phrase paired recordings by scoring unit."
              }
            },
            "required": [
              "native_asset_id",
              "current_asset_id",
              "next_step",
              "completed_steps"
            ],
            "additionalProperties": false
          },
          "unit_intervals": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                }
              ]
            },
            "description": "Actual scoped intervals in source order per unit, in piece-local24kHz samples; legacy single intervals remain readable. No character proportions."
          },
          "word_intervals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_cp": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Half-open exact 24kHz sample or Unicode codepoint coordinate as named."
                },
                "end_cp": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Half-open exact 24kHz sample or Unicode codepoint coordinate as named."
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Half-open exact 24kHz sample or Unicode codepoint coordinate as named."
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Half-open exact 24kHz sample or Unicode codepoint coordinate as named."
                }
              },
              "required": [
                "start_cp",
                "end_cp",
                "start",
                "end"
              ],
              "additionalProperties": false,
              "description": "Decoder-derived codepoint/source sample association, not auditory confirmation."
            },
            "description": "Accepted native timing for exact selected words; no proportional guess."
          }
        },
        "required": [
          "id",
          "utterance_id",
          "operation_indexes",
          "request_sha256",
          "source_asset_id",
          "asset_id",
          "audio_sha256",
          "sample_count",
          "state",
          "receipt_ids",
          "last_error_asset_id"
        ],
        "additionalProperties": false
      },
      "description": "Ordered complete values."
    },
    "assembled_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "description": "Existing version-scoped identifier."
        },
        {
          "type": "null"
        }
      ],
      "description": "Existing version-scoped identifier."
    },
    "assembled_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA-256 of actual immutable bytes or JCS payload as declared."
    },
    "sample_map_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Private exact sample map, null until actual complete bytes exist."
    },
    "diagnostic_asset_id": {
      "type": "string",
      "description": "Private assembly quality/pace diagnostic separate from the strict sample-map asset."
    },
    "composition": {
      "$ref": "speech-composition.schema.json",
      "description": "Durable admitted resolved schedule. Absent for historic sequential progress."
    }
  },
  "required": [
    "schema_version",
    "id",
    "preparation_id",
    "revision",
    "render_plan_sha256",
    "production_plan_asset_id",
    "pieces",
    "assembled_asset_id",
    "assembled_sha256",
    "sample_map_asset_id"
  ],
  "additionalProperties": false
}
