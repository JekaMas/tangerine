{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/review-context.schema.json",
  "title": "review-context",
  "type": "object",
  "description": "Current LLM processing record or lossless imported source record; no human peer review prerequisite.",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "The local contract version."
    },
    "id": {
      "type": "string",
      "description": "The review context.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "case_version_id": {
      "type": "string",
      "description": "The exact case.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "audio_sha256": {
      "type": "string",
      "description": "The final delivery digest.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "person_id": {
      "anyOf": [
        {
          "type": "string",
          "description": "The imported native reviewer, null for LLM review.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Legacy imported value; null for LLM processing."
    },
    "qualification_ids": {
      "type": "array",
      "description": "Applicable unexpired competence records.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "author_person_ids": {
      "type": "array",
      "description": "The real case authors.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "description": "Declared conflicts.",
      "items": {
        "type": "string",
        "description": "An actual conflict or prior exposure.",
        "maxLength": 2000,
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 50
    },
    "prior_key_exposure": {
      "type": "boolean",
      "description": "Whether this person saw this key before blind submission."
    },
    "other_review_exposure": {
      "type": "boolean",
      "description": "Whether this person saw another blind submission."
    },
    "phase": {
      "type": "string",
      "description": "The activity phase.",
      "enum": [
        "blind_open",
        "blind_submitted",
        "key_disclosed",
        "final_submitted",
        "invalidated"
      ]
    },
    "created_at": {
      "type": "string",
      "description": "The creation time.",
      "maxLength": 35,
      "minLength": 20,
      "format": "date-time"
    },
    "origin": {
      "type": "string",
      "enum": [
        "llm",
        "source_import"
      ],
      "description": "Actual label origin; never a claim of new human peer review."
    },
    "provider_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "uniqueItems": true
    },
    "input_modality": {
      "type": "string",
      "enum": [
        "text",
        "text_with_speech_evidence",
        "audio",
        "native_annotation"
      ],
      "description": "Actual input modality; transcript-only models never claim direct hearing."
    }
  },
  "required": [
    "schema_version",
    "id",
    "case_version_id",
    "audio_sha256",
    "person_id",
    "qualification_ids",
    "author_person_ids",
    "conflicts",
    "prior_key_exposure",
    "other_review_exposure",
    "phase",
    "created_at",
    "origin",
    "provider_receipt_ids",
    "input_modality"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "llm"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "person_id": {
            "const": null
          },
          "qualification_ids": {
            "maxItems": 0
          },
          "provider_receipt_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
