{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/audio-measurement.schema.json",
  "title": "audio-measurement",
  "type": "object",
  "description": "Requested controls never populate observed values.",
  "properties": {
    "id": {
      "type": "string",
      "description": "The observation.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "audio_sha256": {
      "type": "string",
      "description": "The final delivery file.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "method_id": {
      "type": "string",
      "description": "The exact registered method.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "method_version": {
      "type": "string",
      "description": "The code/library version and parameter digest.",
      "maxLength": 200,
      "minLength": 1
    },
    "feature": {
      "type": "string",
      "description": "A registered measurement name.",
      "maxLength": 100,
      "minLength": 1
    },
    "interval": {
      "type": "object",
      "description": "An interval on an identified audio clock. End must exceed start.",
      "properties": {
        "start": {
          "type": "integer",
          "description": "Inclusive sample index.",
          "minimum": 0,
          "maximum": 2147483647
        },
        "end": {
          "type": "integer",
          "description": "Exclusive sample index.",
          "minimum": 1,
          "maximum": 2147483647
        },
        "sample_rate_hz": {
          "type": "integer",
          "description": "The sample clock in Hz as an integer.",
          "enum": [
            16000,
            24000,
            44100,
            48000
          ]
        }
      },
      "required": [
        "start",
        "end",
        "sample_rate_hz"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "description": "Actual measurement status; uncertain or unsupported observations are not_measurable with reason, never a human review requirement.",
      "enum": [
        "observed",
        "not_applicable",
        "not_measurable",
        "failed"
      ]
    },
    "numeric_value": {
      "anyOf": [
        {
          "type": "string",
          "description": "A finite decimal observation.",
          "maxLength": 4097,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "A finite decimal observation."
    },
    "categorical_value": {
      "anyOf": [
        {
          "type": "string",
          "description": "Registered categorical observation with native/model origin retained.",
          "maxLength": 1000,
          "minLength": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "Registered categorical observation with native/model origin retained."
    },
    "unit": {
      "type": "string",
      "description": "The registered unit.",
      "enum": [
        "dBFS",
        "LUFS",
        "dBTP",
        "ms",
        "wpm",
        "ratio",
        "semitones",
        "semitones_per_second",
        "category"
      ]
    },
    "evidence_asset_ids": {
      "type": "array",
      "description": "Raw measurements, machine findings or imported native annotations.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "description": "The exact missingness or failure reason.",
          "maxLength": 1000,
          "minLength": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "The exact missingness or failure reason."
    },
    "target_unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "description": "Exact case-scoped target for an auditory finding or explicit model-omitted unknown. Native/ASR aggregate rows omit it."
    },
    "auditory_finding": {
      "type": "object",
      "description": "Actually supplied model finding, including additional model annotations. These remain inference data, never native numeric scores. Omitted targets do not manufacture a finding.",
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "description": "Existing version-scoped identifier."
        },
        "feature": {
          "type": "string",
          "minLength": 1,
          "description": "Exact saved value."
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "contradicted",
            "uncertain",
            "not_applicable"
          ],
          "description": "Exactly one declared value."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Exact saved value."
        },
        "clip_interval": {
          "anyOf": [
            {
              "type": "object",
              "description": "Half-open sample interval on the saved 24kHz piece; end exceeds start.",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Nonnegative exact integer."
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Nonnegative exact integer."
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Half-open sample interval on the saved 24kHz piece; end exceeds start."
        },
        "proposed_ipa": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Exact saved value."
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact saved value."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Exact saved value."
        }
      },
      "required": [
        "unit_id",
        "feature",
        "status",
        "description",
        "clip_interval",
        "proposed_ipa",
        "reason"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "audio_sha256",
    "method_id",
    "method_version",
    "feature",
    "interval",
    "status",
    "numeric_value",
    "categorical_value",
    "unit",
    "evidence_asset_ids",
    "reason"
  ],
  "additionalProperties": false
}
