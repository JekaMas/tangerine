{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "phase_states": {
      "$ref": "preparation-state.schema.json#/properties/phase_states"
    },
    "audio_available": {
      "type": "boolean"
    },
    "last_failure": {
      "$ref": "preparation-state.schema.json#/properties/last_failure"
    },
    "next_render_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "speech_profile_id": {
      "type": "string"
    },
    "render_progress_summary": {
      "type": "object",
      "properties": {
        "complete_pieces": {
          "type": "integer",
          "minimum": 0
        },
        "total_pieces": {
          "type": "integer",
          "minimum": 0
        },
        "first_unfinished_piece_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ready_to_assemble": {
          "type": "boolean"
        }
      },
      "required": [
        "complete_pieces",
        "total_pieces",
        "first_unfinished_piece_id",
        "ready_to_assemble"
      ],
      "additionalProperties": false
    },
    "canonical_word_count": {
      "$ref": "preparation-state.schema.json#/properties/canonical_word_count"
    },
    "surface_word_count": {
      "$ref": "preparation-state.schema.json#/properties/surface_word_count"
    },
    "exercise_request": {
      "$ref": "exercise-request.schema.json",
      "description": "Original accepted request copied into new preparation metadata for visible readback. Optional for older or full advanced-only preparations; no inferred legacy values."
    },
    "created_at": {
      "$ref": "preparation-state.schema.json#/properties/created_at",
      "description": "projection of the existing creation timestamp; optional for older summary responses. Never the read time."
    }
  },
  "required": [
    "id",
    "revision",
    "phase_states",
    "audio_available",
    "last_failure"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/preparation-summary.schema.json",
  "title": "preparation-summary"
}
