{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/llm-quality-dataset.schema.json",
  "title": "llm-quality-dataset",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "Current specification contract."
    },
    "scope": {
      "type": "string",
      "enum": [
        "stage",
        "answer_pipeline",
        "generation_pipeline",
        "full_flow"
      ],
      "description": "Comparable input scope."
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "case_generation",
            "linguistic_audit",
            "blind_claim_extraction",
            "claim_mapping",
            "mapping_audit",
            "feedback",
            "case_review",
            "adjudication"
          ],
          "description": "Stage under test."
        },
        {
          "type": "null"
        }
      ],
      "description": "Stage under test."
    },
    "phase": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "canonical_text",
            "mutation"
          ],
          "description": "Generation phase; null for other stages."
        },
        {
          "type": "null"
        }
      ],
      "description": "Generation phase; null for other stages."
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "llm-quality-case.schema.json"
      },
      "description": "Ordered unique frozen case records."
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "JCS dataset excluding this field."
    }
  },
  "required": [
    "schema_version",
    "scope",
    "stage",
    "phase",
    "cases",
    "dataset_sha256"
  ],
  "additionalProperties": false,
  "description": "Explicit frozen comparison population.",
  "$defs": {
    "answer_pipeline_input": {
      "type": "object",
      "properties": {
        "ground_truth": {
          "$ref": "ground-truth.schema.json"
        },
        "answer_asset_id": {
          "type": "string",
          "description": "Actual unchanged UTF-8 answer asset."
        },
        "answer_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Original answer bytes."
        },
        "task_components": {
          "type": "object",
          "properties": {
            "detection": {
              "const": true,
              "description": "This flag states whether the task requests error detection."
            },
            "classification": {
              "type": "boolean",
              "description": "This flag states whether the task requests a category for each detected error."
            },
            "correction": {
              "type": "boolean",
              "description": "This flag or object describes correction requirements or decisions in its parent contract."
            },
            "explanation": {
              "type": "boolean",
              "description": "Legacy explanation invitation preference. Under answer-components-v2 explanation is optional and every supplied explanation is assessed independently, regardless of this flag; it does not enter the primary composite."
            }
          },
          "required": [
            "detection",
            "classification",
            "correction",
            "explanation"
          ],
          "additionalProperties": false,
          "description": "These flags freeze the requested answer components before the attempt."
        }
      },
      "required": [
        "ground_truth",
        "answer_asset_id",
        "answer_sha256",
        "task_components"
      ],
      "additionalProperties": false,
      "description": "Fixed answer-pipeline exercise/key/audio/answer input."
    }
  }
}
