{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/review-request.schema.json",
  "title": "review-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "purpose": {
      "enum": [
        "case_review",
        "answer_reconsideration",
        "dispute"
      ]
    },
    "case_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "statement": {
      "type": "string",
      "maxLength": 20000
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "target_case_version_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "case_version_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "answer_reconsideration"
          }
        }
      },
      "then": {
        "required": [
          "attempt_id",
          "result_id"
        ],
        "properties": {
          "attempt_id": {
            "type": "string"
          },
          "result_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "dispute"
          }
        }
      },
      "then": {
        "required": [
          "statement"
        ],
        "properties": {
          "statement": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
