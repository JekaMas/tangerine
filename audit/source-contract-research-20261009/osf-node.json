{"data":{"id":"r638b","type":"nodes","attributes":{"title":"The influence of L1 typology on the acquisition of the L2 English Article","description":"Our multilingual capacity is central to human cognition. Adult second language learning, in particular, sheds light on learning across the lifespan with far-reaching consequences for language learning practice as well as intercultural communication. This project investigates importantly how the mother tongue (L1) influences second language learning (L2) by looking at the linguistic distance between L1 and L2. In this paper, We present a corpus investigation of the influence of L1-L2 typological similarity on the acquisition of the L2 English article. ","category":"project","custom_citation":null,"date_created":"2025-02-14T23:05:02.138427","date_modified":"2025-10-19T20:20:32.857234","registration":false,"preprint":true,"fork":false,"collection":false,"tags":[],"access_requests_enabled":true,"node_license":{"copyright_holders":[""],"year":"2025"},"analytics_key":"","current_user_can_comment":false,"current_user_permissions":["read"],"current_user_is_contributor":false,"current_user_is_contributor_or_group_member":false,"wiki_enabled":true,"public":true,"subjects":[[{"id":"584240da54be81056cecaab4","text":"Arts and Humanities"}],[{"id":"584240da54be81056cecac48","text":"Social and Behavioral Sciences"}]]},"relationships":{"license":{"links":{"related":{"href":"https://api.osf.io/v2/licenses/563c1cf88c5e4a3877f9e96c/","meta":{}}},"data":{"id":"563c1cf88c5e4a3877f9e96c","type":"licenses"}},"children":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/r638b/children/","meta":{}}}},"collected_in":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/r638b/collections/","meta":{}}}},"comments":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/r638b/comments/?filter%5Btarget%5D=r638b","meta":{}}}},"contributors":{"links":{"related":{"href":"https://api.osf.io/v2/nodes/r638b/contributors/","meta":{}}}},"bibliogr