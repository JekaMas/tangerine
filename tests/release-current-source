name='tangerine-current-source-'+uuid.uuid4().hex[:8];env=dict(os.environ,COMPOSE_PROJECT_NAME=name,DOCKER_DEFAULT_PLATFORM='linux/arm64');obs={};browser=None;focus=os.environ.get("TANGERINE_RELEASE_SOURCE_FOCUS");startup_only=focus=="startup"
