#!/usr/bin/env python3
"""Opt-in actual local model observations; pinned host binary, disposable data.
Docker Desktop cannot reach this host's Ollama listener. Cross-compile with the
existing pinned Go image; do not install tools, download models or modify preview.
"""
from pathlib import Path
import json,os,platform,secrets,subprocess,sys,tempfile,time,uuid
r=Path(__file__).resolve().parents[1];name='tangerine-local-mutation-'+uuid.uuid4().hex[:12];env={**os.environ}
def call(args,check=True,input=None):
 p=subprocess.run(args,cwd=r,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180,input=input)
 if p.stdout:print(p.stdout,file=sys.stderr,end='')
 if check and p.returncode:raise RuntimeError('local observation setup failed')
 return p
clean_required='--require-clean' in sys.argv
test_args=[x for x in sys.argv[1:] if x!='--require-clean']
pin={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip(),'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=r,text=True).strip())}
if clean_required and pin['dirty']:raise SystemExit('Committed-clean local observation requires a clean checkout')
(r/'data/iteration6/local/tmp').mkdir(parents=True,exist_ok=True)
with tempfile.TemporaryDirectory(prefix=name,dir=r/'data/iteration6/local/tmp') as tmp:
 tmp=Path(tmp);config=tmp/'runtime.env';password=secrets.token_hex(24)
 config.write_text('POSTGRES_DB=tangerine\nPOSTGRES_USER=tangerine\nPOSTGRES_PASSWORD='+password+'\nMINIO_ROOT_USER=native-regression\nMINIO_ROOT_PASSWORD='+password+'\nDATABASE_URL=postgres://tangerine:'+password+'@postgres:5432/tangerine?sslmode=disable\nMINIO_ENDPOINT=minio:9000\nMINIO_ACCESS_KEY=native-regression\nMINIO_SECRET_KEY='+password+'\nMINIO_BUCKET=regressions\n');config.chmod(0o600)
 try:
  call(['docker','build','--target','build','-t',name+'-go','-f','services/api/Dockerfile','.'])
  call(['docker','build','-t',name+'-minio','-f','deploy/local/minio.Dockerfile','.'])
  call(['docker','network','create',name])
  call(['docker','run','-d','--name',name+'-postgres','--network',name,'--network-alias','postgres','-p','127.0.0.1::5432','--env-file',str(config),'postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826'])
  call(['docker','run','-d','--name',name+'-media','--network',name,'--network-alias','minio','-p','127.0.0.1::9000','--env-file',str(config),name+'-minio'])
  for kind in ['postgres','media']:
   for n in range(60):
    args=['docker','exec',name+'-'+kind]+(['pg_isready','-h','127.0.0.1','-U','tangerine','-d','tangerine'] if kind=='postgres' else ['/usr/local/bin/probe','http://127.0.0.1:9000/minio/health/ready'])
    if subprocess.run(args,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:break
    time.sleep(.5)
   else:raise RuntimeError('native service not ready')
  call(['docker','run','--rm','--network',name,'--env-file',str(config),'--entrypoint','/tangerine',name+'-go','initialize'])
  bundle=tmp/'local-bundle.json'
  bundle.write_text(call(['docker','run','--rm','-i','--entrypoint','/tangerine',name+'-go','lab-json'],input='{"action":"builtins"}').stdout)
  cache=r/'data/iteration6/local/go-cache';cache.mkdir(parents=True,exist_ok=True)
  mounts=['-v',str(cache)+':/root/.cache/go-build']
  for src in ['native_preparation_test.go','native_mutation_test.go','native_local_mutation_test.go']:mounts+=['-v',str(r/'tests'/src)+':/src/internal/app/'+src+':ro']
  goos={'Darwin':'darwin','Linux':'linux'}[platform.system()];goarch={'arm64':'arm64','aarch64':'arm64','x86_64':'amd64'}[platform.machine()]
  call(['docker','run','--rm','-e','CGO_ENABLED=0','-e','GOOS='+goos,'-e','GOARCH='+goarch,'-v',str(tmp)+':/hostbin',*mounts,'--entrypoint','go',name+'-go','test','-c','-o','/hostbin/local-model.test','./internal/app'])
  def port(kind,p):return subprocess.check_output(['docker','port',name+'-'+kind,p],env=env,text=True).strip().rsplit(':',1)[1]
  evidence=r/'data/iteration6/local'/name;evidence.mkdir(parents=True,exist_ok=True)
  run_env={**env,'DATABASE_URL':'postgres://tangerine:'+password+'@127.0.0.1:'+port('postgres','5432/tcp')+'/tangerine?sslmode=disable','MINIO_ENDPOINT':'127.0.0.1:'+port('media','9000/tcp'),'MINIO_ROOT_USER':'native-regression','MINIO_ROOT_PASSWORD':password,'TANGERINE_PREPARATION_TEST_EVIDENCE':str(evidence),'TANGERINE_LOCAL_MUTATION_BUNDLE':str(bundle)}
  p=subprocess.run([str(tmp/'local-model.test'),'-test.v','-test.run',test_args[0] if test_args else '^TestNativeLocal','-test.timeout','500s'],cwd=r,env=run_env,timeout=540,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True);status=p.returncode
  print(p.stdout,end='');(evidence/'test-output.log').write_text(p.stdout)
  final={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip(),'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=r,text=True).strip())}
  observed=[line.split()[2] for line in p.stdout.splitlines() if line.startswith('--- PASS: TestNativeLocal')]
  expected=['TestNativeLocalMutationPositive','TestNativeLocalZeroMutationNegative'] if not test_args else [test_args[0].strip('^$')]
  if sorted(observed)!=sorted(expected):status=1
  receipt={'observed_tests':observed,'expected_tests':expected,'git':pin,'git_after':final,'require_clean':clean_required,'exit_code':status,'status':'passed' if status==0 and final==pin else 'failed','evidence_root':str(evidence.relative_to(r)),'model':'gpt-oss:20b','billing_mode':'local','fixture_response':False}
  (evidence/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt))
  if final!=pin:status=1
 finally:
  for kind in ['postgres','media']:call(['docker','rm','-f','-v',name+'-'+kind],check=False)
  call(['docker','network','rm',name],check=False)
  for kind in ['go','minio']:call(['docker','image','rm',name+'-'+kind],check=False)
 sys.exit(status)
