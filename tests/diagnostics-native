#!/usr/bin/env python3
"""Native Go acceptance with an owned disposable PostgreSQL/MinIO stack, no ports."""
from pathlib import Path
import json,os,secrets,subprocess,sys,tempfile,time,uuid
r=Path(__file__).resolve().parents[1];name='tangerine-diagnostic-'+uuid.uuid4().hex[:12];env={**os.environ}
def call(args,check=True):
 p=subprocess.run(args,cwd=r,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=900)
 if p.stdout:print(p.stdout,file=sys.stderr,end='')
 if check and p.returncode:raise RuntimeError('native test setup command failed')
 return p
with tempfile.TemporaryDirectory(prefix=name) as tmp:
 config=Path(tmp)/'runtime.env';password=secrets.token_hex(24);config.write_text('POSTGRES_DB=tangerine\nPOSTGRES_USER=tangerine\nPOSTGRES_PASSWORD='+password+'\nMINIO_ROOT_USER=native-regression\nMINIO_ROOT_PASSWORD='+password+'\nDATABASE_URL=postgres://tangerine:'+password+'@postgres:5432/tangerine?sslmode=disable\nMINIO_ENDPOINT=minio:9000\nMINIO_ACCESS_KEY=native-regression\nMINIO_SECRET_KEY='+password+'\nMINIO_BUCKET=regressions\n');config.chmod(0o600)
 try:
  call(['docker','build','--target','build','-t',name+'-go','-f','services/api/Dockerfile','.'])
  call(['docker','build','-t',name+'-minio','-f','deploy/local/minio.Dockerfile','.'])
  call(['docker','network','create',name])
  runtime=env.get('TANGERINE_SPEECH_TEST_RUNTIME_IMAGE')
  if not runtime:
   call(['docker','build','-t',name+'-speech','-f','services/speech/Dockerfile','.']);runtime=name+'-speech'
  # Explicitly selected, actually qualified dependency image + exact production
  # source mount. This never substitutes a synthesis/parser/storage owner.
  speech_secret=[]
  if env.get('TANGERINE_GEMINI_TEST_ENV_FILE'):speech_secret=['--env-file',str(Path(env['TANGERINE_GEMINI_TEST_ENV_FILE']).resolve())]
  call(['docker','run',*speech_secret,'-d','--name',name+'-speech','--network',name,'--network-alias','speech','-e','SPEECH_INTERNAL_TOKEN=actual-local-speech-test','--tmpfs','/models:rw','-v',str(r/'data/iteration7/models/kokoro-local-en-v1')+':/models/kokoro-local-en-v1:ro','-v',str(r/'data/iteration16/models/faster-whisper-local-en-v1')+':/models/faster-whisper-local-en-v1:ro','-v',str(r/'data/iteration16/models/qwen25-omni-3b-audio-v1')+':/models/qwen25-omni-3b-audio-v1:ro','-v',str(r/'services/speech')+':/app:ro',runtime])
  call(['docker','run','-d','--name',name+'-postgres','--network',name,'--network-alias','postgres','--env-file',str(config),'postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826'])
  call(['docker','run','-d','--name',name+'-media','--network',name,'--network-alias','minio','--env-file',str(config),name+'-minio'])
  for kind in ['postgres','media']:
   for n in range(60):
    args=['docker','exec',name+'-'+kind]+(['pg_isready','-h','127.0.0.1','-U','tangerine','-d','tangerine'] if kind=='postgres' else ['/usr/local/bin/probe','http://127.0.0.1:9000/minio/health/ready'])
    if subprocess.run(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:break
    time.sleep(.5)
   else:raise RuntimeError('native service not ready')
  call(['docker','run','--rm','--network',name,'--env-file',str(config),'--entrypoint','/tangerine',name+'-go','initialize'])
  go_args=['test','-run','^TestNativeDiagnostic',*sys.argv[2:]] if len(sys.argv)>1 and sys.argv[1]=='test' else ['test','-json','-race','-count=1','-run',sys.argv[1] if len(sys.argv)>1 else '^TestNativeDiagnostic','./internal/app']
  evidence=r/'data/iteration16/native'/name;evidence.mkdir(parents=True,exist_ok=True)
  print('Private evidence: '+str(evidence.relative_to(r)),file=sys.stderr)
  args=['docker','run','--rm','--network',name,'--env-file',str(config),'-e','TANGERINE_PREPARATION_TEST_EVIDENCE=/evidence','-e','TANGERINE_SPEECH_TEST_URL=http://speech:8090','-v',str(evidence)+':/evidence','-v',str(r/'tests/native_preparation_test.go')+':/src/internal/app/native_preparation_test.go:ro','-v',str(r/'tests/native_mutation_test.go')+':/src/internal/app/native_mutation_test.go:ro','-v',str(r/'tests/native_speech_test.go')+':/src/internal/app/native_speech_test.go:ro','-v',str(r/'tests/native_listening_test.go')+':/src/internal/app/native_listening_test.go:ro','-v',str(r/'tests/native_acoustic_test.go')+':/src/internal/app/native_acoustic_test.go:ro','-v',str(r/'tests/native_audio_diagnostics_test.go')+':/src/internal/app/native_audio_diagnostics_test.go:ro','--entrypoint','go',name+'-go',*go_args]
  if env.get('TANGERINE_AUDIO_JUDGE_TEST_PROFILE'):
   index=args.index('--entrypoint');args[index:index]=['-e','TANGERINE_AUDIO_JUDGE_TEST_PROFILE=/audio-test-profile.json','-v',str(Path(env['TANGERINE_AUDIO_JUDGE_TEST_PROFILE']).resolve())+':/audio-test-profile.json:ro']
  p=subprocess.run(args,cwd=r,env=env,timeout=900,capture_output=True,text=True)
  print(p.stdout,end='');print(p.stderr,file=sys.stderr,end='');(evidence/'go-test.jsonl').write_text(p.stdout)
  status=p.returncode
  observed=[]
  for line in p.stdout.splitlines():
   try:row=json.loads(line)
   except ValueError:continue
   if row.get('Action')=='pass' and row.get('Test'):observed.append(row['Test'])
  if status==0 and {'TestNativeDiagnosticActualASRPositive','TestNativeDiagnosticActualAuditoryPositive'}.issubset(observed):
   pointer=r/'data/iteration16/receipts/diagnostics-current.json';pointer.parent.mkdir(parents=True,exist_ok=True);pointer.write_text(json.dumps(dict(root=str(evidence.relative_to(r)),observed_tests=observed,status='passed',source_revision=subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip()),indent=2))
 finally:
  for kind in ['postgres','media','speech']:call(['docker','rm','-f','-v',name+'-'+kind],check=False)
  call(['docker','network','rm',name],check=False)
  for kind in ['go','minio','speech']:call(['docker','image','rm',name+'-'+kind],check=False)
 sys.exit(status)
