# --require-clean additionally refuses a dirty informational invocation.
clean_required=clean_required or not pin['dirty']
if clean_required and pin['dirty']:raise SystemExit('Committed-clean local observation requires a clean checkout')
(r/'data/iteration12/local/tmp').mkdir(parents=True,exist_ok=True)
with tempfile.TemporaryDirectory(prefix=name,dir=r/'data/iteration12/local/tmp') as tmp:
 tmp=Path(tmp);config=tmp/'runtime.env';password=secrets.token_hex(24)
 config.write_text('POSTGRES_DB=tangerine\nPOSTGRES_USER=tangerine\nPOSTGRES_PASSWORD='+password+'\nMINIO_ROOT_USER=native-regression\nMINIO_ROOT_PASSWORD='+password+'\nDATABASE_URL=postgres://tangerine:'+password+'@postgres:5432/tangerine?sslmode=disable\nMINIO_ENDPOINT=minio:9000\nMINIO_ACCESS_KEY=native-regression\nMINIO_SECRET_KEY='+password+'\nMINIO_BUCKET=regressions\n');config.chmod(0o600)
 try:
  call(['docker','build','--target','build','-t',name+'-go','-f','services/api/Dockerfile','.'])
  call(['docker','build','-t',name+'-minio','-f','deploy/local/minio.Dockerfile','.'])
  call(['docker','network','create',name])
  call(['docker','run','-d','--name',name+'-postgres','--network',name,'--network-alias','postgres','-p','127.0.0.1::5432','--env-file',str(config),'postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826'])
  call(['docker','run','-d','--name',name+'-media','--network',name,'--network-alias','minio','-p','127.0.0.1::9000','--env-file',str(config),name+'-minio'])
  for kind in ['postgres','media']:
   for n in range(60):
    args=['docker','exec',name+'-'+kind]+(['pg_isready','-h','127.0.0.1','-U','tangerine','-d','tangerine'] if kind=='postgres' else ['/usr/local/bin/probe','http://127.0.0.1:9000/minio/health/ready'])
    if subprocess.run(args,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:break
    time.sleep(.5)
   else:raise RuntimeError('native service not ready')
  call(['docker','run','--rm','--network',name,'--env-file',str(config),'--entrypoint','/tangerine',name+'-go','initialize'])
  bundle=tmp/'unused-bundle.json'
  cache=r/'data/iteration12/local/go-cache';cache.mkdir(parents=True,exist_ok=True)
  mounts=['-v',str(cache)+':/root/.cache/go-build']
  host_fixture=tmp/'native_listening_test.go';host_fixture.write_text((r/'tests/native_listening_test.go').read_text().replace('"minio:9000"','os.Getenv("MINIO_ENDPOINT")'))
  for src in ['native_listening_test.go','native_interpretation_test.go','native_scoring_test.go','native_local_scoring_test.go','native_review_test.go','native_local_review_test.go']:mounts+=['-v',str(host_fixture if src=='native_listening_test.go' else r/'tests'/src)+':/src/internal/app/'+src+':ro']
  goos={'Darwin':'darwin','Linux':'linux'}[platform.system()];goarch={'arm64':'arm64','aarch64':'arm64','x86_64':'amd64'}[platform.machine()]
  call(['docker','run','--rm','-e','CGO_ENABLED=0','-e','GOOS='+goos,'-e','GOARCH='+goarch,'-v',str(tmp)+':/hostbin',*mounts,'--entrypoint','go',name+'-go','test','-c','-o','/hostbin/local-model.test','./internal/app'])
  def port(kind,p):return subprocess.check_output(['docker','port',name+'-'+kind,p],env=env,text=True).strip().rsplit(':',1)[1]
  evidence=r/'data/iteration12/local'/name;evidence.mkdir(parents=True,exist_ok=True)
  run_env={**env,'DATABASE_URL':'postgres://tangerine:'+password+'@127.0.0.1:'+port('postgres','5432/tcp')+'/tangerine?sslmode=disable','MINIO_ENDPOINT':'127.0.0.1:'+port('media','9000/tcp'),'MINIO_ROOT_USER':'native-regression','MINIO_ROOT_PASSWORD':password,'TANGERINE_INTERPRETATION_EVIDENCE':str(evidence),'TANGERINE_LOCAL_MUTATION_BUNDLE':str(bundle),'TANGERINE_LOCAL_MUTATION_PROFILE':str(profile_path),'TANGERINE_LOCAL_MAPPING_PROFILE':str(mapping_path)}
  p=subprocess.run([str(tmp/'local-model.test'),'-test.v','-test.run',test_args[0] if test_args else '^TestLocalReview','-test.timeout','1800s'],cwd=r,env=run_env,timeout=1900,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True);status=p.returncode
  (evidence/'test-output.log').write_text(p.stdout)
  events=subprocess.run(['docker','run','--rm','-i','--entrypoint','go',name+'-go','tool','test2json','-p','tangerine.local/api/internal/app'],input=p.stdout,capture_output=True,text=True,env=env,check=True);print(events.stdout,end='')
  final={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip(),'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=r,text=True).strip())}
  observed=[line.split()[2] for line in p.stdout.splitlines() if line.startswith('--- PASS: TestLocalReview')]
  expected=[n for n in ['TestLocalReviewCasePositive','TestLocalReviewSoundDisputeNegative','TestLocalReviewMappingPositive','TestLocalReviewWrongDisputeNegative','TestLocalReviewKeyPositive','TestLocalReviewFalseReasonNegative'] if not test_args or re.search(test_args[0],n)]
  if sorted(observed)!=sorted(expected):status=1
  receipt={'observed_tests':observed,'expected_tests':expected,'git':pin,'git_after':final,'require_clean':clean_required,'exit_code':status,'status':'passed' if status==0 and final==pin else 'failed','evidence_root':str(evidence.relative_to(r)),'model':'stage-specific local profiles','models_by_stage':{'case_review':mapping_profile['model'],'adjudication':mapping_profile['model']},'semantic_stages':'controlled external protocol fixture','billing_mode':'local','fixture_response':False}
  (evidence/'receipt.json').write_text(json.dumps(receipt,indent=2)+'\n');print(json.dumps(receipt),file=sys.stderr)
  if final!=pin:status=1
 finally:
  for kind in ['postgres','media']:call(['docker','rm','-f','-v',name+'-'+kind],check=False)
  call(['docker','network','rm',name],check=False)
  for kind in ['go','minio']:call(['docker','image','rm',name+'-'+kind],check=False)
 sys.exit(status)
