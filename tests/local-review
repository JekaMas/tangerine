#!/usr/bin/env python3
"""Opt-in actual local model observations; pinned host binary, disposable data.
Docker Desktop cannot reach this host's Ollama listener. Cross-compile with the
existing pinned Go image; do not install tools, download models or modify preview.
"""
from pathlib import Path
import re,json,os,platform,secrets,subprocess,sys,tempfile,time,uuid
r=Path(__file__).resolve().parents[1];name='tangerine-local-review-'+uuid.uuid4().hex[:12];env={**os.environ}
def call(args,check=True,input=None):
 p=subprocess.run(args,cwd=r,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=180,input=input)
 if p.stdout:print(p.stdout,file=sys.stderr,end='')
 if check and p.returncode:raise RuntimeError('local observation setup failed')
 return p
profile_path=r/'audit/iteration-11-scoring-20261021/LOCAL-PROFILE.json'
selected_profile=json.loads(profile_path.read_text())
mapping_path=r/'audit/iteration-12-review-20261021/LOCAL-PROFILE.json'
mapping_profile=json.loads(mapping_path.read_text())
clean_required='--require-clean' in sys.argv
test_args=[x for x in sys.argv[1:] if x not in ('--require-clean','test')]
pin={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=r,text=True).strip(),'dirty':bool(subprocess.check_output(['git','status','--porcelain'],cwd=r,text=True).strip())}
