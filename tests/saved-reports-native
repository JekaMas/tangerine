#!/usr/bin/env python3
"""Selected saved-report tests: real disposable DB/media, no provider runtime.

Browser mode serves only the test-owned schema; input is driven through CUA.
This runner never launches a browser, installs dependencies or contacts a model.
"""
from pathlib import Path
import os, secrets, subprocess, sys, tempfile, time, uuid

ROOT = Path(__file__).resolve().parents[1]
DATA = Path(os.environ.get('TANGERINE_SAVED_REPORT_EVIDENCE', ROOT/'data/iteration-28-reports-20261026')).resolve()
DATA.mkdir(parents=True, exist_ok=True)
NAME = 'tangerine-saved-reports-' + uuid.uuid4().hex[:8]
BROWSER = '--browser' in sys.argv
PATTERN = '^TestSavedReportsBrowserFixture$' if BROWSER else (sys.argv[1] if len(sys.argv)>1 else '^TestNativeSaved')
ENV = dict(os.environ)


def command(args, check=True):
    result = subprocess.run(args, cwd=ROOT, env=ENV, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=900)
    print(result.stdout, file=sys.stderr, end='')
    if check and result.returncode:
        raise RuntimeError('Owned native setup failed: ' + args[0])
    return result


with tempfile.TemporaryDirectory(prefix=NAME) as temp:
    config=Path(temp)/'runtime.env'
    password=secrets.token_hex(24)
    config.write_text('POSTGRES_DB=tangerine\nPOSTGRES_USER=tangerine\nPOSTGRES_PASSWORD='+password+'\nMINIO_ROOT_USER=saved-reports\nMINIO_ROOT_PASSWORD='+password+'\nDATABASE_URL=postgres://tangerine:'+password+'@postgres:5432/tangerine?sslmode=disable\nMINIO_ENDPOINT=minio:9000\nMINIO_ACCESS_KEY=saved-reports\nMINIO_SECRET_KEY='+password+'\nMINIO_BUCKET=regressions\nAPI_INTERNAL_TOKEN=saved-report-test-token\nAPI_INTERNAL_URL=http://api:8080\n')
    config.chmod(0o600)
    try:
        command(['docker','build','--target','build','-t','tangerine-i28-go','-f','services/api/Dockerfile','.'])
        command(['docker','build','-t','tangerine-i28-media','-f','deploy/local/minio.Dockerfile','.'])
        command(['docker','network','create',*(['--internal'] if not BROWSER else []),NAME])
        for kind,image,alias in [('postgres','postgres:17-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826','postgres'),('media','tangerine-i28-media','minio')]:
            command(['docker','run','-d','--name',NAME+'-'+kind,'--network',NAME,'--network-alias',alias,'--env-file',str(config),image])
            for _ in range(120):
                probe=['pg_isready','-h','127.0.0.1','-U','tangerine','-d','tangerine'] if kind=='postgres' else ['/usr/local/bin/probe','http://127.0.0.1:9000/minio/health/ready']
                if subprocess.run(['docker','exec',NAME+'-'+kind,*probe],env=ENV,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0:break
                time.sleep(.2)
            else:raise RuntimeError('Owned dependency unavailable')
        if BROWSER:
            command(['docker','build','-t','tangerine-i28-web','-f','services/web/Dockerfile','.'])
            command(['docker','run','-d','--name',NAME+'-web','--network',NAME,'--env-file',str(config),'-p','127.0.0.1::3000','tangerine-i28-web'])
            (DATA/'browser-stack.json').write_text(__import__('json').dumps(dict(name=NAME,web_port=command(['docker','port',NAME+'-web','3000/tcp']).stdout.strip().rsplit(':',1)[1]))+'\n')
        args=['docker','run','--rm','--name',NAME+'-api','--network',NAME,'--network-alias','api','--env-file',str(config),'-e','TANGERINE_SAVED_REPORT_EVIDENCE=/evidence','-v',str(DATA)+':/evidence','-v',str(ROOT/'tests/saved_reports_native_test.go')+':/src/internal/app/saved_reports_native_test.go:ro','--entrypoint','go','tangerine-i28-go','test','-json','-race','-count=1','-timeout','46m','-run',PATTERN,'./internal/app']
        result=subprocess.run(args,cwd=ROOT,env=ENV,timeout=2850)
        status=result.returncode
    finally:
        for kind in ['web','api','postgres','media']:
            command(['docker','rm','-f','-v',NAME+'-'+kind],False)
        command(['docker','network','rm',NAME],False)
    sys.exit(status)
