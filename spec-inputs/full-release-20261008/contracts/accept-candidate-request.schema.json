{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/accept-candidate-request.schema.json",
  "title": "accept-candidate-request",
  "type": "object",
  "description": "Create a draft case from the actual candidate.",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "An existing valid candidate.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "candidate_sha256": {
      "type": "string",
      "description": "The frozen candidate.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "parent_case_version_id": {
      "anyOf": [
        {
          "type": "string",
          "description": "A genuine parent for a revised case.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "A genuine parent for a revised case."
    }
  },
  "required": [
    "candidate_id",
    "candidate_sha256",
    "parent_case_version_id"
  ],
  "additionalProperties": false
}
