{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/speech-render-result.schema.json",
  "title": "speech-render-result",
  "type": "object",
  "description": "Internal speech output, not a synthesized success placeholder.",
  "properties": {
    "plan_sha256": {
      "type": "string",
      "description": "The exact input plan.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "delivery_asset_id": {
      "type": "string",
      "description": "The actual linked delivery.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "audio_sha256": {
      "type": "string",
      "description": "The complete final WAV.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "turns": {
      "type": "array",
      "description": "All turns.",
      "items": {
        "type": "object",
        "description": "One actual ordered turn interval.",
        "properties": {
          "turn_id": {
            "type": "string",
            "description": "The source turn.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "utterance_id": {
            "type": "string",
            "description": "The corresponding utterance.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "start_sample": {
            "type": "integer",
            "description": "Final-clock start.",
            "minimum": 0,
            "maximum": 2147483647
          },
          "end_sample": {
            "type": "integer",
            "description": "Final-clock end.",
            "minimum": 1,
            "maximum": 2147483647
          },
          "receipt_id": {
            "type": "string",
            "description": "The actual provider response.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        },
        "required": [
          "turn_id",
          "utterance_id",
          "start_sample",
          "end_sample",
          "receipt_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "transformation_ids": {
      "type": "array",
      "description": "Actual assembly transforms.",
      "items": {
        "type": "string",
        "description": "An existing identifier.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    }
  },
  "required": [
    "plan_sha256",
    "delivery_asset_id",
    "audio_sha256",
    "turns",
    "transformation_ids"
  ],
  "additionalProperties": false
}
