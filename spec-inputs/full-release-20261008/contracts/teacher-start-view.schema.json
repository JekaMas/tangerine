{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tangerine.invalid/schemas/teacher-start-view.schema.json",
  "title": "teacher-start-view",
  "type": "object",
  "description": "The pre-submit teacher allowlist.",
  "properties": {
    "attempt_id": {
      "type": "string",
      "description": "The started attempt.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "started_at": {
      "type": "string",
      "description": "The database start time.",
      "maxLength": 35,
      "minLength": 20,
      "format": "date-time"
    },
    "case": {
      "$ref": "library-item.schema.json"
    },
    "audio_path": {
      "type": "string",
      "description": "A same-origin internal media path, not a storage URL.",
      "maxLength": 500,
      "minLength": 1,
      "pattern": "^/api/v1/attempts/[^/]+/audio$"
    },
    "task_components": {
      "type": "object",
      "properties": {
        "detection": {
          "const": true,
          "description": "This flag states whether the task requests error detection."
        },
        "classification": {
          "type": "boolean",
          "description": "This flag states whether the task requests a category for each detected error."
        },
        "correction": {
          "type": "boolean",
          "description": "This flag or object describes correction requirements or decisions in its parent contract."
        },
        "explanation": {
          "type": "boolean",
          "description": "This flag or object describes explanation requirements or judgments in its parent contract."
        }
      },
      "required": [
        "detection",
        "classification",
        "correction",
        "explanation"
      ],
      "additionalProperties": false,
      "description": "These flags freeze the requested answer components before the attempt."
    },
    "requested_language": {
      "type": "string",
      "description": "The response language.",
      "enum": [
        "en",
        "ru"
      ]
    },
    "maximum_answer_codepoints": {
      "const": 20000,
      "description": "The existing exact input limit."
    }
  },
  "required": [
    "attempt_id",
    "started_at",
    "case",
    "audio_path",
    "task_components",
    "requested_language",
    "maximum_answer_codepoints"
  ],
  "additionalProperties": false
}
